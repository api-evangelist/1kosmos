      "item": [
        {
          "id": "35228982-dcf3-4600-8abb-e285a5fdff45",
          "name": "Get Tenant Community Info",
          "request": {
            "name": "Get Tenant Community Info",
            "description": {
              "content": "This API is used to fetch the complete details of both the tenant and the community that were set as the environment variables.\n\nThese details include configured tenant dns name and the list of other tenant DNS. Additionally, the community details include the logo URL used in the community, tenant tag, and so on. The logo details will be displayed only if you had set the skipLogos parameter in the payload to false.\n\nMandatory Parmameters\n\ndns - Use the dns name of the tenant as a variable.\n\ncommunityName - Specify the community name as a variable.\n\nOptional Parameters\nskipLogos - This is a boolean parameter. Specifying this value as false displays the logo details in the response.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "r1",
                "system",
                "community_info",
                "fetch"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "Your BlockID tenant DNS name as shown in the BlockID developer dashboard. blockid-trial.1kosmos.net is the trial tenant used throughout the published docs.",
                  "type": "any",
                  "value": "{{tenantDNS}}",
                  "key": "tenantDNS"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "<object>",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "4c9c5615-2d84-423e-98aa-aa9bb3384ff3",
              "name": "Tenant Community Info",
              "originalRequest": {
                "url": {
                  "path": [
                    "api",
                    "r1",
                    "system",
                    "community_info",
                    "fetch"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": [
                    {
                      "description": "Your BlockID tenant DNS name as shown in the BlockID developer dashboard. blockid-trial.1kosmos.net is the trial tenant used throughout the published docs.",
                      "type": "any",
                      "value": "{{tenantDNS}}",
                      "key": "tenantDNS"
                    }
                  ]
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: apikey",
                      "type": "text/plain"
                    },
                    "key": "licensekey",
                    "value": "<API Key>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"dns\": \"{{tenantDNS}}\",\n  \"communityName\": \"{{community_name}}\",\n  \"skipLogos\": false\n}",
                  "options": {
